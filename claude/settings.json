{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch"
    ],
    "deny": [
      "Bash(*drizzle-kit migrate*)",
      "Bash(*drizzle-kit push*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pnpm db:migrate*)",
      "Bash(rm -fr *)",
      "Bash(rm -rf *)",
      "Bash(rtk git commit *)",
      "Bash(rtk git push *)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "mcp__claude_ai_Slack__slack_add_list_comment",
      "mcp__claude_ai_Slack__slack_add_list_record",
      "mcp__claude_ai_Slack__slack_add_reaction",
      "mcp__claude_ai_Slack__slack_complete_file_upload",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_create_conversation",
      "mcp__claude_ai_Slack__slack_create_list",
      "mcp__claude_ai_Slack__slack_get_file_upload_url",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Slack__slack_update_list",
      "mcp__claude_ai_Slack__slack_update_list_comment",
      "mcp__claude_ai_Slack__slack_update_list_record"
    ],
    "ask": [
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Edit(**/*.env)",
      "Edit(**/*.env.*)",
      "Bash(sudo *)",
      "Bash(git clone *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(npm install *)",
      "Bash(pnpm db:reset*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE '(^|[^[:alnum:]_-])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+stash([[:space:]]|;|$)' && { echo \"git stash is blocked. Test another state of the code in a worktree or a scratch branch.\" >&2; exit 2; } || exit 0"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "n=$(jq -r \".tool_name // \\\"\\\"\" | sed \"s/^mcp__claude_ai_Slack__//\"); if ! echo \"$n\" | grep -qiE \"send|post|schedule|create|update|edit|delete|add|remove|upload|invite|join|leave|archive|set|draft|write|mark\" && echo \"$n\" | grep -qiE \"read|search|get|list|fetch|view|find|lookup\"; then exit 0; fi; echo \"Slack MCP is read-only: $n is blocked.\" >&2; exit 2"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "theme": "dark-ansi",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "idleCompaction": false,
  "autoContinueAtUsageLimit": false,
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true
}
