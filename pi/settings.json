{
  "lastChangelogVersion": "0.83.0",
  "theme": "catppuccin-mocha",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "editorPaddingX": 1,
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-mcp-adapter",
