configuration {
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
}

@theme "catppucin"

* {
    font: "JetBrainsMono Nerd Font Propo 14";

    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 1200;
    border-radius: 20px;

    border: 2px;
    border-color: @blue;
    background-color: @bg0;
}

mainbox {
    padding: 20px;
}

inputbar {
    background-color: @bg1;
    border-radius: 16px;
    border: 2px;
    border-color: @bg3;

    padding: 10px 16px;
    margin: 0 0 20px 0;
}

prompt {
    text-color: @blue;
}

entry {
    placeholder: "Search wallpaper...";
    placeholder-color: @cyan;
}

listview {
    columns: 4;
    lines: 2;
    spacing: 20px;
    cycle: true;
    dynamic: true;
    layout: vertical;

    background-color: transparent;
}

element {
    orientation: vertical;
    border-radius: 18px;
    padding: 12px;
    spacing: 10px;

    background-color: @bg1;
}

element selected {
    background-color: @bg2;
    border: 2px;
    border-color: @blue;
}

element-icon {
    size: 320px;
    border-radius: 12px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @fg0;
}
