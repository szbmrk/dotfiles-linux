{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "hyprland/window",
    ],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        // "custom/nvim",
        // "custom/vscode",
        "disk",
        "network",
        "memory",
        "backlight",
        "pulseaudio#source",
        "pulseaudio#output",
        "battery",
        // "custom/settings",
        "custom/swaync",
        "custom/powermenu",
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
    },
    "hyprland/window": {
        "icon": true,
        "icon-size": 18,
        "format": "{}",
        "max-length": 40,
    },
    "hyprland/submap": {
        "format": " {}",
    },
    // "wlr/taskbar": {
    //     "format": "{icon}",
    //     "icon-size": 16,
    //     "icon-theme": "Numix-Circle",
    //     "tooltip-format": "{title}",
    //     "on-click": "activate",
    //     "on-click-right": "close",
    //     "app_ids-mapping": {
    //         "firefoxdeveloperedition": "firefox-developer-edition",
    //     },
    //     "rewrite": {
    //         "Firefox Web Browser": "Firefox",
    //         "Foot Server": "Terminal",
    //     },
    // },
    "clock": {
        "format": "<span color='#89dceb' font-size='large'><b></b></span> {:%B %d. %H:%M}",
        "format-alt": "<span color='#89dceb' font-size='large'><b></b></span> {:%A, %B %d. %Y %H:%M}",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>",
            },
        },
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click-right": "dms ipc call dash toggle overview",
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
    },
    "custom/nvim": {
        "tooltip": false,
        "format": "",
        "on-click": "python /home/szobo/.config/scripts/nvim-recents.py",
    },
    "custom/vscode": {
        "tooltip": false,
        "format": "󰨞",
        "on-click": "python /home/szobo/.config/scripts/vscode-recents.py",
    },
    "disk": {
        "format": " {percentage_used}%",
        "format-alt": " {used}/{total}",
        "interval": 30,
        "path": "/home",
    },
    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " disconnected",
        "interval": 5,
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "on-click": "dms ipc call control-center toggle",
    },
    "memory": {
        "format": " {percentage}%",
        "format-alt": " {used:0.1f}G/{total:0.1f}G",
        "interval": 10,
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "{volume}% 󰍬",
        "format-muted": "󰍭",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "scroll-step": 5,
    },
    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " muted",
        "on-click": "dms ipc call control-center toggle",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%",
    },
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", ""],
        },
        "on-click": "dms ipc call control-center toggle",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15,
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "interval": 10,
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "󰃠 {percent}%",
        "on-click": "dms ipc call control-center toggle",
    },
    "custom/settings": {
        "tooltip": false,
        "format": "",
        "on-click": "dms ipc call control-center toggle",
    },
    "custom/swaync": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/swaync-status.sh",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client --toggle-dnd",
        "on-click-middle": "swaync-client -C",
        "interval": 1,
    },
    "custom/powermenu": {
        "tooltip": false,
        "format": " ",
        "on-click": "wlogout",
    },
}
